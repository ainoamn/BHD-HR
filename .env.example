# PostgreSQL (Neon). Pooled URL for the app, direct URL (host without -pooler) for prisma db push.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/bhd_hr?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/bhd_hr?sslmode=require"

# Signs the product session cookie. Use a long random value in production.
AUTH_SECRET=""

# Public origin of this site (required in production; used for redirect/logout URLs)
# APP_ORIGIN="https://bhd-hr.vercel.app"

# BHD unified sign-in (docs/BHD-PRODUCT-SSO-ADMIN.md). Leave BHD_OAUTH_CLIENT_ID empty
# to keep the local password sign-in until the client is registered in ONE-BHD.
BHD_IDENTITY_ISSUER="https://id.bhd-om.com"
BHD_OAUTH_CLIENT_ID=""
BHD_OAUTH_CLIENT_SECRET=""
BHD_OAUTH_REDIRECT_URI=""
# Access is per company: a new BHD account gets its own company as admin; other companies
# add members by email in Settings → Company members.
# Optional HS256 fallback for id_token verification (only if ONE-BHD issues one for this client)
# BHD_IDENTITY_TOKEN_SECRET=""

# Platform owners: comma-separated emails that open /admin (all companies, plans, payments).
# Admins can also be granted from /admin/users.
PLATFORM_ADMIN_EMAILS=""

# Card payments with Thawani Pay (Oman). Without the keys companies pay by bank transfer and
# a platform admin confirms it. THAWANI_MODE="live" for real payments; anything else = test cards.
# Thawani webhook URL: https://YOUR-SITE/api/billing/webhook
THAWANI_SECRET_KEY=""
THAWANI_PUBLISHABLE_KEY=""
THAWANI_MODE=""

# Daily job (vercel.json crons) sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""

# Email (Resend): receipts, subscription reminders, invites, daily brief.
RESEND_API_KEY=""
MAIL_FROM=""

# WhatsApp Cloud API (optional).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE=""
WHATSAPP_NOTICE_TEMPLATE=""
WHATSAPP_ACCOUNT_TEMPLATE=""
WHATSAPP_TEMPLATE_LANG="ar"
