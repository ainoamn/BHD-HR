generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Company {
  id                   String              @id @default(cuid())
  name                 String
  nameEn               String?
  crNumber             String?
  phone                String?
  email                String?
  address              String?
  logoUrl              String?
  currency             String              @default("ر.ع")
  salaryDays           Int                 @default(30)
  alertUrgentDays      Int                 @default(7)
  alertWarningDays     Int                 @default(30)
  alertEarlyDays       Int                 @default(60)
  /// Document types shown in expiry alerts and the documents expiry views (src/lib/alert-docs.ts). Null = all types.
  alertDocTypes        Json?
  payDay               Int                 @default(0)
  leaveWarningDays     Int                 @default(5)
  /// 0 until the built-in job titles, departments and leave types are seeded (src/lib/hr-catalog.ts).
  catalogVersion       Int                 @default(0)
  /// Social Protection Fund (src/lib/oman.ts). Rates are percentages; off until the admin turns it on.
  spfEnabled           Boolean             @default(false)
  spfEmployeeRate      Float               @default(8)
  spfEmployerRate      Float               @default(14.5)
  spfExpatEmployerRate Float               @default(2)
  spfWageCap           Float               @default(3000)
  /// GROSS = basic + fixed allowances + recurring allowances; BASIC = basic only.
  spfBase              String              @default("GROSS")
  /// Payer bank for the WPS salary file.
  bankBic              String?
  bankAccount          String?
  /// Clock-in from the employee portal (src/lib/clock.ts): work site, allowed distance in metres, start time "HH:MM" Muscat.
  clockEnabled         Boolean             @default(false)
  workLat              Float?
  workLng              Float?
  workRadius           Int                 @default(200)
  workStart            String?
  /// Permission lists the admin set per role (src/lib/permissions.ts); a role that is missing uses the built-in preset.
  rolePermissions      Json?
  /// Electronic signature on issued letters (src/lib/letter-seal.ts). Images are copied onto each letter when it is signed.
  signatoryName        String?
  signatoryTitle       String?
  signatureUrl         String?
  stampUrl             String?
  /// Letter kinds an employee asks for from the portal that are issued at once, signed, without a person approving.
  letterAutoKinds      Json?
  /// Salaries are paid only after the month's payroll is approved (src/lib/payroll-period.ts).
  payrollApproval      Boolean             @default(false)
  payrollPeriods       PayrollPeriod[]
  /// A portal link opened on a new device asks for the last 4 characters of the ID / passport number (src/lib/portal-device.ts).
  portalDeviceCheck    Boolean             @default(true)
  /// Work schedules and overtime (src/lib/work-time.ts): the schedule of employees without their own, rates as multiples of the hourly basic wage.
  defaultScheduleId    String?
  overtimeDayRate      Float               @default(1.25)
  overtimeNightRate    Float               @default(1.5)
  overtimeRestRate     Float               @default(2)
  /// Lateness and early leave are deducted from pay when the month's timesheet is approved.
  latenessDeduct       Boolean             @default(false)
  workSchedules        WorkSchedule[]
  timeSheets           TimeSheet[]
  /// ACTIVE or SUSPENDED by the platform admin (nobody in the company can work until it is reactivated).
  status               String              @default("ACTIVE")
  suspendedReason      String?
  /// IP of the request that created the company (sign-up), for the platform admin.
  signupIp             String?
  subscription         Subscription?
  payments             Payment[]
  employees            Employee[]
  leaveRequests        LeaveRequest[]
  employeeRequests     EmployeeRequest[]
  clockEntries         ClockEntry[]
  jobTitles            JobTitle[]
  departments          Department[]
  leaveTypes           LeaveType[]
  allowanceTypes       AllowanceType[]
  employeeAllowances   EmployeeAllowance[]
  employers            Employer[]
  memberships          Membership[]
  reminders            Reminder[]
  salaries             Salary[]
  payItems             PayItem[]
  files                StoredFile[]
  auditLogs            AuditLog[]
  tasks                Task[]
  employeeNotes        EmployeeNote[]
  letters              Letter[]
  letterDrafts         LetterDraft[]
  letterTemplates      LetterTemplate[]
  /// Company-written policies shown on /regulations (اطّلاع) alongside Oman labour library.
  companyPolicies      CompanyPolicy[]
  /// Extra warning causes beyond the built-in Oman MD 618/2024 schedule.
  companyPenaltyCauses CompanyPenaltyCause[]
  briefs               DailyBrief[]
  jobOpenings          JobOpening[]
  candidates           Candidate[]
  reviewCycles         ReviewCycle[]
  reviews              PerformanceReview[]
  assets               Asset[]
  expenseClaims        ExpenseClaim[]
  heldDocuments        HeldDocument[]
  custodyForms         CustodyForm[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

/// AI summary of the day's priorities, cached per company, day, language and permission set.
model DailyBrief {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  day       String
  lang      String
  /// Short hash of the viewer's permissions, so nobody sees a brief built from data they cannot open.
  scope     String
  text      String
  createdAt DateTime @default(now())

  @@unique([companyId, day, lang, scope])
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  password           String
  mustChangePassword Boolean      @default(true)
  bhdSub             String?      @unique
  /// Sign-in name of an account the system opened for an employee or sponsor (src/lib/accounts.ts).
  username           String?      @unique
  /// That account's first password, encrypted so HR can share it again; cleared once the person sets their own.
  tempPassword       String?
  picture            String?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  /// Runs the whole platform (/admin): companies, plans, payments. Separate from every company role.
  isPlatformAdmin    Boolean      @default(false)
  /// Set by the platform admin: the person cannot sign in anywhere until it is cleared.
  disabledAt         DateTime?
  memberships        Membership[]
  auditLogs          AuditLog[]
  loginEvents        LoginEvent[]
  createdAt          DateTime     @default(now())
}

/// Each sign-in, with the IP it came from (src/lib/login-events.ts); kept 180 days.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  /// BHD (single sign-on) or LOCAL (username / password).
  method    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// A subscription plan (src/lib/plans.ts). Prices in rials (3 decimals); a null limit means unlimited.
model Plan {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  nameEn        String?
  tagline       String?
  taglineEn     String?
  priceMonthly  Float          @default(0)
  priceYearly   Float          @default(0)
  maxEmployees  Int?
  maxUsers      Int?
  /// Feature keys on top of the core (FEATURES in src/lib/plans.ts).
  features      Json?
  /// Listed on the pricing page; a hidden plan is assigned by the platform admin only.
  isPublic      Boolean        @default(true)
  /// Priced on request: shown with "contact us", never bought online.
  contactOnly   Boolean        @default(false)
  isActive      Boolean        @default(true)
  highlight     Boolean        @default(false)
  sortOrder     Int            @default(0)
  subscriptions Subscription[]
  payments      Payment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// The company's plan, one row per company. A company without one is a legacy account with everything open.
/// Whether it still grants access is worked out from the dates (src/lib/subscription.ts).
model Subscription {
  id                 String    @id @default(cuid())
  companyId          String    @unique
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  /// TRIAL, ACTIVE, or CANCELED (keeps working to the period end, then stops).
  status             String    @default("TRIAL")
  /// MONTHLY or YEARLY.
  cycle              String    @default("MONTHLY")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  /// null while ACTIVE = no end date (granted by the platform admin).
  currentPeriodEnd   DateTime?
  /// Platform admin overrides of the plan's limits (null = the plan's).
  maxEmployees       Int?
  maxUsers           Int?
  /// Feature keys granted on top of the plan.
  extraFeatures      Json?
  notes              String?
  /// "<end date>:<days>" of the last expiry reminder, so each one goes out once.
  lastReminder       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// A payment or payment attempt for a subscription (src/lib/billing.ts).
model Payment {
  id            String    @id @default(cuid())
  /// Receipt number shown as INV-000123.
  number        Int       @unique @default(autoincrement())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId        String?
  plan          Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName      String
  cycle         String
  amount        Float
  currency      String    @default("OMR")
  /// PENDING, PAID, FAILED or CANCELED.
  status        String    @default("PENDING")
  /// THAWANI (card checkout) or MANUAL (bank transfer or cash, confirmed by the platform admin).
  provider      String
  /// Checkout session id at the provider.
  providerRef   String?   @unique
  /// Transfer reference or cheque number typed by the company or the platform admin.
  reference     String?
  periodStart   DateTime?
  periodEnd     DateTime?
  paidAt        DateTime?
  createdById   String?
  createdByName String?
  ip            String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, createdAt])
  @@index([status, createdAt])
}

/// Platform-wide settings: a single row with id "platform" (src/lib/platform.ts).
model PlatformConfig {
  id            String   @id @default("platform")
  /// Plan and length of the free trial every new company starts on.
  trialPlanCode String   @default("BUSINESS")
  trialDays     Int      @default(14)
  /// Bank account shown to companies that pay by transfer.
  bankDetails   String?
  supportEmail  String?
  supportPhone  String?
  /// A notice shown at the top of every company's pages (maintenance, offers).
  announcement  String?
  updatedAt     DateTime @updatedAt
}

/// What platform admins did; company activity stays in AuditLog.
model PlatformLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  companyId String?
  action    String
  message   String
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([companyId, createdAt])
}

/// Platform-wide scheduled greeting / occasion notice (admin console). Designs a card with AI and emails a filtered audience.
model PlatformGreeting {
  id           String                    @id @default(cuid())
  /// Short occasion name, e.g. العيد الوطني.
  title        String
  /// What the occasion means (shown to AI and optionally in the message).
  meaning      String
  /// Free-text brief that drives the AI design.
  brief        String
  scheduledFor DateTime
  /// Audience filter: { all?, genders?, omanis?, expats?, nationalities?, youthMaxAge?, companyIds? }.
  audience     Json
  /// DRAFT | READY | SCHEDULED | SENT | FAILED | CANCELLED
  status       String                    @default("DRAFT")
  subjectAr    String?
  subjectEn    String?
  bodyAr       String?
  bodyEn       String?
  imagePrompt  String?
  currentVersionId String?               @unique
  currentVersion   PlatformGreetingVersion? @relation("GreetingCurrent", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions     PlatformGreetingVersion[] @relation("GreetingVersions")
  sentAt       DateTime?
  sentCount    Int                       @default(0)
  lastError    String?
  createdById  String?
  createdByName String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@index([status, scheduledFor])
}

model PlatformGreetingVersion {
  id          String   @id @default(cuid())
  greetingId  String
  greeting    PlatformGreeting @relation("GreetingVersions", fields: [greetingId], references: [id], onDelete: Cascade)
  currentOf   PlatformGreeting? @relation("GreetingCurrent")
  /// Public token for `/api/greetings/img/<token>` (email clients need no admin session).
  token       String   @unique
  subjectAr   String
  subjectEn   String
  bodyAr      String
  bodyEn      String
  imagePrompt String
  mime        String   @default("image/png")
  imageData   Bytes
  /// Admin note that requested this revision (empty for the first design).
  reviseNote  String?
  createdAt   DateTime @default(now())

  @@index([greetingId, createdAt])
}

/// Access to one company (workspace). userId stays empty for an invitation until that email signs in.
model Membership {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("VIEWER")
  /// Permission list used when role = CUSTOM (see src/lib/permissions.ts).
  permissions Json?
  inviteToken String?   @unique
  invitedById String?
  invitedAt   DateTime?
  acceptedAt  DateTime?
  /// The employee or sponsor this account belongs to; EMPLOYEE / TEAM_MANAGER / EMPLOYER see only their own people.
  employeeId  String?   @unique
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employerId  String?   @unique
  employer    Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([companyId, email])
  @@index([userId])
  @@index([email])
}

model Employer {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  kind      String      @default("COMPANY")
  name      String
  nameEn    String?
  idNumber  String?
  phone     String?
  email     String?
  address   String?
  logoUrl   String?
  notes     String?
  /// Short Latin code shown in employee numbers, e.g. SFH → SFH-0001 (src/lib/employee-number.ts).
  employeeCode   String?
  /// How many times employee numbers were rebuilt for this sponsor; first rebuild is free, later ones need the actor's password.
  numberRebuilds Int     @default(0)
  employees Employee[]
  salaries  Salary[]
  account   Membership?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Employee {
  id                 String              @id @default(cuid())
  employeeNumber     String
  /// Scope for EMP-#### sequencing: the employer (كفيل) id, or "" when none. Set at create and kept if the employer later changes.
  numberScope        String              @default("")
  fullName           String
  nameEn             String?
  /// ISO country code (src/lib/nationalities.ts); older rows may still hold a nationality name.
  nationality        String?
  gender             String?
  dateOfBirth        DateTime?
  phone              String?
  email              String?
  address            String?
  idNumber           String?
  idExpiry           DateTime?
  idFileUrl          String?
  passportNumber     String?
  passportExpiry     DateTime?
  passportFileUrl    String?
  residenceNumber    String?
  residenceExpiry    DateTime?
  residenceFileUrl   String?
  /// SWIFT/BIC of the employee's bank (src/lib/banks.ts) and the account salaries go to; used by the WPS file.
  bankBic            String?
  bankAccount        String?
  /// File fields the employee filled in from the portal and declared correct, {field: {at, via}} (src/lib/self-data.ts); a mark goes when HR changes that value.
  selfProvided       Json?
  /// Direct manager (an employee of the same company), for the org chart.
  managerId          String?
  manager            Employee?           @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports            Employee[]          @relation("ReportsTo")
  /// After a sponsor-to-sponsor transfer: the old file points here; the new file has `transferredFromId`.
  transferredToId    String?             @unique
  transferredTo      Employee?           @relation("EmployeeTransfer", fields: [transferredToId], references: [id], onDelete: SetNull)
  transferredFrom    Employee?           @relation("EmployeeTransfer")
  /// Own work schedule; empty = the company's default schedule.
  scheduleId         String?
  schedule           WorkSchedule?       @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  timeSheets         TimeSheet[]
  pushSubscriptions  PushSubscription[]
  notices            NoticeLog[]
  /// Key of the employee's personal portal link /portal/<token>; null = no portal.
  portalToken        String?             @unique
  /// Profile photo (/files/<name>, a square JPEG resized in the browser).
  photoUrl           String?
  /// Key of the public badge page /id/<token> behind the employee's QR code; separate from the portal key.
  badgeToken         String?             @unique
  /// The employee's CV per language, {ar?, en?} of src/lib/cv.ts CvContent; edited from the portal or by HR.
  cv                 Json?
  cvUpdatedAt        DateTime?
  /// Names copied from the chosen JobTitle / Department so lists and prints need no join.
  jobTitle           String?
  jobTitleEn         String?
  /// MoL occupation code and skill class copied from JobTitle when assigned.
  jobCode            String?
  jobClass           String?
  jobTitleId         String?
  jobTitleRef        JobTitle?           @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  department         String?
  departmentEn       String?
  departmentId       String?
  departmentRef      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  joiningDate        DateTime?
  contractEnd        DateTime?
  status             String              @default("ACTIVE")
  /// Set when the status becomes TERMINATED (turnover figures); empty for employees ended before it was tracked.
  terminatedAt       DateTime?
  annualLeaveDays    Float               @default(30)
  sickLeaveDays      Float               @default(0)
  otherLeaveDays     Float               @default(0)
  /// Days per leave-type key that differ from the type's default; the three columns above are pre-leave-type values.
  leaveDays          Json?
  basicSalary        Float               @default(0)
  housingAllowance   Float               @default(0)
  transportAllowance Float               @default(0)
  otherAllowance     Float               @default(0)
  notes              String?
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  employerId         String?
  employer           Employer?           @relation(fields: [employerId], references: [id])
  documents          EmployeeDocument[]
  attendance         Attendance[]
  leaveCredits       LeaveCredit[]
  salaries           Salary[]
  payItems           PayItem[]
  allowances         EmployeeAllowance[]
  auditLogs          AuditLog[]
  reminders          Reminder[]
  taskAssignments    TaskAssignee[]
  ledTasks           Task[]              @relation("TaskLead")
  noteEntries        EmployeeNote[]
  letters            Letter[]
  leaveRequests      LeaveRequest[]
  requests           EmployeeRequest[]
  clockEntries       ClockEntry[]
  hiredFrom          Candidate[]
  reviews            PerformanceReview[]
  assets             Asset[]
  expenseClaims      ExpenseClaim[]
  heldDocuments      HeldDocument[]
  custodyForms       CustodyForm[]
  account            Membership?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([companyId, numberScope, employeeNumber])
  @@index([companyId, employerId])
}

model JobTitle {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  nameAr        String
  nameEn        String?
  /// Ministry of Labour unified occupation code (رمز المهنة), e.g. 1120001001.
  code          String?
  /// Skill / fee class from the MoL guide: "1" | "2" | "3" (الفئة الأولى / الثانية / الثالثة).
  skillClass    String?
  /// Bilingual job description (src/lib/job-description.ts), drafted by AI and edited by HR; shared by everyone with this title.
  description   Json?
  descriptionAt DateTime?
  descriptionBy String?
  employees     Employee[]
  createdAt     DateTime   @default(now())

  @@unique([companyId, nameAr])
  @@unique([companyId, code])
  @@index([companyId, code])
}

model Department {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  nameAr    String
  nameEn    String?
  employees Employee[]
  createdAt DateTime   @default(now())

  @@unique([companyId, nameAr])
}

/// A leave balance. `key` is what Attendance.balanceKey and LeaveCredit.balanceKey store (annual, sick, … or a generated key).
model LeaveType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  key         String
  nameAr      String
  nameEn      String?
  days        Float    @default(0)
  /// false = only employees whose job title is in jobTitleIds.
  allJobs     Boolean  @default(true)
  jobTitleIds String[] @default([])
  sortOrder   Int      @default(0)
  /// ONCE = `days` once for the whole service (top-ups as credits); YEARLY = `days` every calendar year;
  /// MONTHLY = days ÷ 12 earned each month. Unused days carry into the next year up to carryCap (null = all).
  cycle       String   @default("ONCE")
  carryCap    Float?
  createdAt   DateTime @default(now())

  @@unique([companyId, key])
}

/// A named allowance (علاوة) with its default calculation and payment frequency.
model AllowanceType {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id])
  nameAr     String
  nameEn     String?
  /// FIXED amount or PERCENT of `base` (BASIC salary or the whole PACKAGE).
  calc       String              @default("FIXED")
  base       String              @default("BASIC")
  value      Float               @default(0)
  /// MONTHLY, QUARTERLY, SEMI_ANNUAL or ANNUAL; non-monthly ones are paid in payMonth and every interval after it.
  frequency  String              @default("MONTHLY")
  payMonth   Int                 @default(1)
  allowances EmployeeAllowance[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

/// An allowance given to one employee; applied to each unpaid salary month it falls due in (src/lib/pay-items.ts).
model EmployeeAllowance {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowanceTypeId String
  allowanceType   AllowanceType @relation(fields: [allowanceTypeId], references: [id])
  calc            String        @default("FIXED")
  base            String        @default("BASIC")
  value           Float         @default(0)
  frequency       String        @default("MONTHLY")
  payMonth        Int           @default(1)
  startYear       Int
  startMonth      Int
  active          Boolean       @default(true)
  lines           SalaryLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId])
  @@index([allowanceTypeId])
}

model Reminder {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  title      String
  date       DateTime
  repeat     String    @default("NONE")
  notes      String?
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model EmployeeDocument {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String
  documentNo  String?
  expiryDate  DateTime?
  fileUrl     String?
  notes       String?
  /// Sent by the employee from the portal; stays unreviewed (reviewedAt null) until HR accepts it.
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Leave asked for from the employee portal. Approval records the attendance period (attendanceGroupId).
model LeaveRequest {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Attendance choice: "leave:<balance key>" or UNPAID_LEAVE.
  choice            String
  fromDate          DateTime
  toDate            DateTime
  days              Float
  reason            String?
  /// PENDING, APPROVED, REJECTED, CANCELLED (by the employee) or REVOKED (HR deleted the approved period).
  status            String    @default("PENDING")
  decidedById       String?
  decidedByName     String?
  decidedAt         DateTime?
  decisionNote      String?
  attendanceGroupId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

/// Something an employee asks for from the portal (src/lib/requests.ts): an official letter, a resignation, a salary advance or anything else.
/// Approving a letter request issues the signed letter (letterId); approving an advance creates the pay item (payItemId).
model EmployeeRequest {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// LETTER, RESIGNATION, ADVANCE, DOCUMENTS or OTHER.
  type            String
  /// LETTER: the letter kind asked for (REQUEST_LETTER_KINDS).
  letterKind      String?
  subject         String?
  details         String?
  /// LETTER: who the letter is addressed to.
  addressee       String?
  /// RESIGNATION: the last working day the employee proposes.
  lastDay         DateTime?
  /// ADVANCE: amount and number of monthly instalments.
  amount          Float?
  installments    Int?
  /// DOCUMENTS: the held originals (HeldDocument ids) the employee wants back, and when they will return them (null = for good).
  documentIds     String[]     @default([])
  dueBack         DateTime?
  custodyForm     CustodyForm?
  /// PENDING, APPROVED, REJECTED or CANCELLED (by the employee).
  status          String       @default("PENDING")
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  letterId        String?      @unique
  letter          Letter?      @relation(fields: [letterId], references: [id], onDelete: SetNull)
  payItemId       String?
  /// RESIGNATION (src/lib/resignation.ts): RS-2026-0001 per company and year; the text the employee signed (Arabic,
  /// and English when not edited); the full name they typed and the signature they drew (PNG data URL); when and from
  /// which address they signed; and a SHA-256 of all of it, so any later change shows on the document.
  refNo           String?
  signedText      String?
  signedTextEn    String?
  signedName      String?
  signature       String?
  signedAt        DateTime?
  signedIp        String?
  fingerprint     String?
  /// RESIGNATION: the last working day management approved (lastDay keeps the one the employee proposed).
  approvedLastDay DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([companyId, refNo])
  @@index([companyId, status])
  @@index([employeeId])
}

/// One working day's clock-in / clock-out from the portal. `day` is YYYY-MM-DD in Muscat time.
model ClockEntry {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  day         String
  inAt        DateTime
  inLat       Float?
  inLng       Float?
  /// Metres from the work site when clocking in / out; null when the company has no site set.
  inDistance  Float?
  outAt       DateTime?
  outLat      Float?
  outLng      Float?
  outDistance Float?
  /// Minutes after the company's start time; 0 when on time or no start time is set.
  lateMinutes Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([employeeId, day])
  @@index([companyId, day])
}

/// A browser that allowed notifications from the employee's portal (src/lib/notify.ts).
model PushSubscription {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

/// A notice sent to an employee, so reminders such as document expiry go out once per kind and reference.
model NoticeLog {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       String
  ref        String
  channels   String
  createdAt  DateTime @default(now())

  @@unique([employeeId, kind, ref])
  @@index([companyId, createdAt])
}

/// Keys the app makes for itself on first use (the web-push VAPID pair); never shown in the UI.
model AppSecret {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

/// A working pattern: times are "HH:MM" Muscat, an end before the start runs past midnight; workDays are 0 = Sunday … 6 = Saturday.
model WorkSchedule {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  nameEn       String?
  startTime    String
  endTime      String
  breakMinutes Int        @default(60)
  /// Minutes after the start that are not counted as late.
  graceMinutes Int        @default(10)
  workDays     Json
  employees    Employee[]
  createdAt    DateTime   @default(now())

  @@index([companyId])
}

/// An employee's approved month of clock-ins: minutes, the money it became and the pay items created for it.
model TimeSheet {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year              Int
  month             Int
  days              Int
  workedMinutes     Int
  lateMinutes       Int
  earlyLeaveMinutes Int
  overtimeDay       Int
  overtimeNight     Int
  overtimeRest      Int
  overtimeAmount    Float
  latenessAmount    Float
  /// PayItem ids created on approval, removed again if the approval is withdrawn.
  payItemIds        Json?
  approvedAt        DateTime @default(now())
  approvedById      String?

  @@unique([employeeId, year, month])
  @@index([companyId, year, month])
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime
  type          String
  notes         String?
  deductsSalary Boolean  @default(false)
  balanceKey    String?
  groupId       String?
  createdAt     DateTime @default(now())

  @@unique([employeeId, date])
}

model LeaveCredit {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  balanceKey String
  days       Float
  reason     String?
  createdAt  DateTime @default(now())
}

model Salary {
  id                 String       @id @default(cuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  employerId         String?
  employer           Employer?    @relation(fields: [employerId], references: [id])
  employerName       String?
  employerNameEn     String?
  employeeName       String
  employeeNameEn     String?
  employeeNumber     String
  jobTitle           String?
  jobTitleEn         String?
  department         String?
  departmentEn       String?
  basicSalary        Float        @default(0)
  housingAllowance   Float        @default(0)
  transportAllowance Float        @default(0)
  otherAllowance     Float        @default(0)
  absenceDays        Float        @default(0)
  absenceDeduction   Float        @default(0)
  otherDeduction     Float        @default(0)
  /// Sums of the pay-item lines below (bonuses, allowances, entitlements / advances, deductions).
  extraEarnings      Float        @default(0)
  extraDeductions    Float        @default(0)
  netSalary          Float        @default(0)
  /// Social Protection Fund: employee share (also a SOCIAL deduction line, inside extraDeductions) and the employer's cost, which is not deducted.
  spfEmployee        Float        @default(0)
  spfEmployer        Float        @default(0)
  notes              String?
  paid               Boolean      @default(false)
  paidAt             DateTime?
  paymentMethod      String?
  paymentReference   String?
  paidByName         String?
  receiptNo          String?
  lines              SalaryLine[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([employeeId, year, month])
  @@unique([companyId, receiptNo])
}

/// Approval state of one company month (src/lib/payroll-period.ts); no row = DRAFT.
model PayrollPeriod {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  /// DRAFT, REVIEW, APPROVED or LOCKED.
  status      String    @default("DRAFT")
  submittedAt DateTime?
  submittedBy String?
  approvedAt  DateTime?
  approvedBy  String?
  lockedAt    DateTime?
  lockedBy    String?
  /// Reason given when the month was sent back or unlocked.
  note        String?
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, year, month])
}

/// Advances, bonuses, allowances, entitlements and deductions that feed monthly salaries (src/lib/pay-items.ts).
model PayItem {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  /// ADVANCE: the whole advance. Other kinds: the amount for each month.
  amount        Float
  issuedAt      DateTime
  startYear     Int
  startMonth    Int
  /// ADVANCE: number of instalments. Other kinds: number of months; empty = every month until stopped.
  months        Int?
  paymentMethod String?
  notes         String?
  stoppedAt     DateTime?
  createdByName String?
  lines         SalaryLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([companyId])
  @@index([employeeId])
}

/// A pay item or allowance applied to one monthly salary. Lines of a paid salary never change.
model SalaryLine {
  id          String             @id @default(cuid())
  salaryId    String
  salary      Salary             @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  payItemId   String?
  payItem     PayItem?           @relation(fields: [payItemId], references: [id], onDelete: SetNull)
  allowanceId String?
  allowance   EmployeeAllowance? @relation(fields: [allowanceId], references: [id], onDelete: SetNull)
  kind        String
  title       String
  titleEn     String?
  amount      Float
  deduct      Boolean

  @@index([salaryId])
  @@index([payItemId])
  @@index([allowanceId])
}

/// Uploaded documents and logos. Kept in the database because serverless hosting has no persistent disk.
model StoredFile {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   @unique
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// A to-do assigned to one or more employees (src/lib/tasks.ts). `position` orders cards inside a status column.
model Task {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  title         String
  description   String?
  /// TODO, IN_PROGRESS, REVIEW, ON_HOLD, DONE or CANCELLED (closed without completion).
  status        String         @default("TODO")
  /// URGENT, HIGH, NORMAL or LOW.
  priority      String         @default("NORMAL")
  startDate     DateTime?
  dueDate       DateTime?
  /// When it was closed (DONE or CANCELLED).
  completedAt   DateTime?
  /// Why it is on hold or was closed without completion.
  statusNote    String?
  /// The status an ON_HOLD task returns to when resumed.
  resumeStatus  String?
  postponeCount Int            @default(0)
  /// Archived tasks leave the board, lists, alerts and calendar until restored.
  archivedAt    DateTime?
  position      Float          @default(0)
  createdById   String?
  createdByName String?
  /// The assignee who leads the task (one of `assignees`); cleared when they leave it.
  leadId        String?
  lead          Employee?      @relation("TaskLead", fields: [leadId], references: [id], onDelete: SetNull)
  assignees     TaskAssignee[]
  items         TaskItem[]
  comments      TaskComment[]
  invites       TaskInvite[]
  mentions      TaskMention[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId, status])
}

/// Someone invited to a task by email. `token` opens /task/<token> without an account, where they can
/// follow the task, tick steps, comment and move it between To do, In progress and Review.
/// `employeeId` is set when the address belongs to one of the company's employees (who is then an assignee).
model TaskInvite {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  email         String
  name          String?
  employeeId    String?
  token         String    @unique
  invitedById   String?
  invitedByName String?
  /// PENDING (no mail service yet; share the link), SENT or FAILED.
  emailStatus   String    @default("PENDING")
  emailError    String?
  sentAt        DateTime?
  lastSeenAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([taskId, email])
  @@index([taskId])
}

model TaskAssignee {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
}

/// Checklist entry inside a task.
model TaskItem {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean       @default(false)
  position  Int           @default(0)
  comments  TaskComment[]
  createdAt DateTime      @default(now())

  @@index([taskId])
}

model TaskComment {
  id         String        @id @default(cuid())
  taskId     String
  task       Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String?
  /// Set when someone invited by email wrote it, so replies can notify them.
  inviteId   String?
  authorName String
  /// COMMENT, or a history entry: STATUS, PRIORITY, ASSIGN, TRANSFER, INVITE, POSTPONE, ARCHIVE, LEAD (see TASK_EVENT).
  kind       String        @default("COMMENT")
  body       String
  /// A reply belongs to a top-level comment (one level deep); deleting the comment deletes its replies.
  parentId   String?
  parent     TaskComment?  @relation("TaskReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    TaskComment[] @relation("TaskReplies")
  /// A comment about one checklist step; it stays in the history if the step is deleted.
  itemId     String?
  item       TaskItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  mentions   TaskMention[]
  createdAt  DateTime      @default(now())

  @@index([taskId])
  @@index([parentId])
  @@index([itemId])
}

/// A personal notice about a task: named with @ in a comment (MENTION), a reply to their comment (REPLY) or made
/// the task lead (LEAD). Everyone on the task still sees the comment. Staff get it in their alerts (`userId`),
/// people invited by email at the top of their link page (`inviteId`); `readAt` is set when they open the task.
model TaskMention {
  id         String       @id @default(cuid())
  taskId     String
  task       Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  kind       String       @default("MENTION")
  userId     String?
  inviteId   String?
  employeeId String?
  name       String
  byName     String
  readAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([userId, readAt])
  @@index([inviteId, readAt])
  @@index([taskId])
}

/// Dated note in an employee's file, written by a system user.
model EmployeeNote {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// GENERAL, PERFORMANCE, CONDUCT, TRAINING or PRAISE.
  kind       String   @default("GENERAL")
  body       String
  pinned     Boolean  @default(false)
  authorId   String?
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
}

/// Warning, notice or letter from management to an employee (src/lib/letters.ts).
/// `token` opens the read-only copy at /letter/<token> that email and WhatsApp copies link to.
/// `verifyToken` is the public check behind the QR code (/verify/<verifyToken>); it can't acknowledge the letter.
/// `fingerprint` is a SHA-256 of the signed content (src/lib/letter-seal.ts), so any change after signing shows on the check page.
model Letter {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind           String
  refNo          String
  issuedAt       DateTime
  subject        String
  subjectEn      String?
  body           String
  bodyEn         String?
  signatoryName  String?
  signatoryTitle String?
  createdById    String?
  createdByName  String?
  token          String           @unique
  viewedAt       DateTime?
  acknowledgedAt DateTime?
  cancelledAt    DateTime?
  /// Certificates: who the letter is addressed to (empty = to whom it may concern).
  addressee      String?
  addresseeEn    String?
  verifyToken    String?          @unique
  signedAt       DateTime?
  signedByName   String?
  fingerprint    String?
  /// E-signature serial ES-2026-000001: per company and year (Muscat time) of signing, never reused.
  signatureNo    String?
  signatureUrl   String?
  stampUrl       String?
  /// Selected ready cause when issuing a warning (e.g. OMAN-618-08); see src/lib/oman-labour.
  clauseCode     String?
  clauseTitle    String?
  request        EmployeeRequest?
  deliveries     LetterDelivery[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([companyId, refNo])
  @@unique([companyId, signatureNo])
  @@index([employeeId])
  @@index([companyId, clauseCode])
}

/// Internal company policy document shown on the اطّلاع (/regulations) page.
model CompanyPolicy {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titleAr     String
  titleEn     String?
  bodyAr      String
  bodyEn      String?
  /// Optional short label (e.g. "دليل الموظف 2026").
  sourceNote  String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, active])
}

/// Company-specific warning cause selectable when issuing a disciplinary letter.
model CompanyPenaltyCause {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  titleAr     String
  titleEn     String?
  detailAr    String?
  detailEn    String?
  /// Suggested Letter.kind (WARNING_1, DEDUCTION_NOTICE, …).
  defaultKind String   @default("WARNING_1")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, active])
}

/// A letter written in /letters/new but not issued: kept in the drafts, or scheduled to issue on `scheduledFor`
/// (src/lib/letter-drafts.ts). Takes no reference or e-signature number until it is issued.
model LetterDraft {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          String
  employeeIds   String[]
  /// The form: subject(En), body(En), addressee, purpose, endDate, signatoryName/Title, channels.
  content       Json
  /// DRAFT, SCHEDULED, ISSUING, ISSUED or FAILED.
  status        String    @default("DRAFT")
  /// Day to issue (UTC midnight of the Muscat date); issued by the morning job or the first visit to /letters that day.
  scheduledFor  DateTime?
  issuedAt      DateTime?
  letterIds     String[]
  error         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status])
  @@index([status, scheduledFor])
}

/// A company's own wording for a written letter kind, saved from /letters/new; listed before the ready library
/// (src/lib/letter-library.ts). May keep `{reason}` and `[[…]]` blanks like the library.
model LetterTemplate {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  subject       String
  subjectEn     String?
  body          String
  bodyEn        String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, kind])
}

/// One copy of a letter to send by EMAIL or WHATSAPP. Stays PENDING until that channel is configured (src/lib/delivery.ts).
model LetterDelivery {
  id        String    @id @default(cuid())
  letterId  String
  letter    Letter    @relation(fields: [letterId], references: [id], onDelete: Cascade)
  channel   String
  target    String
  /// PENDING, SENT or FAILED.
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([letterId])
  @@index([status])
}

/// A vacancy (src/lib/recruitment.ts). `applyToken` opens the public form /apply/<token>; null = not open to the public.
model JobOpening {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  titleEn        String?
  jobTitleId     String?
  departmentId   String?
  department     String?
  departmentEn   String?
  /// Duties and requirements; also what AI screening compares CVs against.
  description    String?
  location       String?
  /// FULL_TIME, PART_TIME, CONTRACT or INTERNSHIP.
  employmentType String      @default("FULL_TIME")
  openings       Int         @default(1)
  salaryMin      Float?
  salaryMax      Float?
  /// OPEN, ON_HOLD or CLOSED.
  status         String      @default("OPEN")
  applyToken     String?     @unique
  closesAt       DateTime?
  createdByName  String?
  candidates     Candidate[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([companyId, status])
}

model Candidate {
  id              String     @id @default(cuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId           String
  job             JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fullName        String
  email           String?
  phone           String?
  nationality     String?
  currentTitle    String?
  experienceYears Float?
  expectedSalary  Float?
  /// HR (added by a user) or APPLY_LINK (public form).
  source          String     @default("HR")
  cvUrl           String?
  coverNote       String?
  /// NEW, SCREENING, INTERVIEW, OFFER, HIRED or REJECTED.
  stage           String     @default("NEW")
  /// HR's own 1–5 rating.
  rating          Int?
  /// AI screening against the job description: 0–100 match, summary, strengths and gaps.
  aiScore         Int?
  aiSummary       String?
  aiStrengths     String[]   @default([])
  aiGaps          String[]   @default([])
  aiAt            DateTime?
  interviewAt     DateTime?
  notes           String?
  rejectReason    String?
  /// The employee record created on hiring.
  employeeId      String?
  employee        Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([companyId, stage])
  @@index([jobId])
}

/// A performance review round (src/lib/performance.ts). `criteria` = [{key, ar, en}], each scored 1–5.
model ReviewCycle {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime?
  /// OPEN or CLOSED.
  status        String              @default("OPEN")
  criteria      Json
  createdByName String?
  reviews       PerformanceReview[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([companyId])
}

model PerformanceReview {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycleId      String
  cycle        ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// DRAFT or DONE.
  status       String      @default("DRAFT")
  /// {criterionKey: 1–5}
  scores       Json?
  overall      Float?
  strengths    String?
  improvements String?
  goals        String?
  comment      String?
  reviewerName String?
  completedAt  DateTime?
  /// Shown in the employee portal from this time.
  sharedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([cycleId, employeeId])
  @@index([employeeId])
}

/// Company property that can be handed to an employee (custody / عهدة).
model Asset {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  /// LAPTOP, PHONE, VEHICLE, ACCESS_CARD, TOOL, UNIFORM, FURNITURE or OTHER.
  category     String       @default("OTHER")
  tag          String?
  serialNo     String?
  value        Float?
  purchaseDate DateTime?
  /// AVAILABLE, ASSIGNED, MAINTENANCE or RETIRED.
  status       String       @default("AVAILABLE")
  employeeId   String?
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  notes        String?
  events       AssetEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

/// History of an asset: CREATE, ASSIGN, RETURN, MAINTENANCE, AVAILABLE or RETIRE.
model AssetEvent {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind         String
  employeeId   String?
  employeeName String?
  note         String?
  byName       String?
  createdAt    DateTime @default(now())

  @@index([assetId])
}

/// An original document the company keeps for an employee: passport, cards, certificates… (src/lib/custody.ts).
model HeldDocument {
  id         String        @id @default(cuid())
  companyId  String
  company    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// HELD_DOC_TYPES in src/lib/custody.ts.
  type       String
  /// Free name, e.g. the degree; shown instead of the type label when set.
  title      String?
  documentNo String?
  /// HELD (with the company) or OUT (handed to the employee).
  status     String        @default("HELD")
  /// While OUT: the date it should come back; null = handed over for good.
  dueBack    DateTime?
  notes      String?
  items      CustodyItem[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

/// A handover form: the company receiving originals from an employee (IN) or handing them over (OUT).
model CustodyForm {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// DC-2026-0001: per company and year.
  refNo          String
  /// IN or OUT.
  direction      String
  purpose        String?
  /// OUT: when the employee should bring the documents back; null = for good.
  dueBack        DateTime?
  /// Who physically handed the documents over and who received them.
  handedByName   String
  receivedByName String
  createdById    String?
  createdByName  String?
  /// Key of the employee's copy; the employee confirms it from the portal.
  token          String           @unique
  acknowledgedAt DateTime?
  requestId      String?          @unique
  request        EmployeeRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  items          CustodyItem[]
  createdAt      DateTime         @default(now())

  @@unique([companyId, refNo])
  @@index([employeeId])
}

/// One document on a handover form; the label and number are copied so the form reads the same later.
model CustodyItem {
  id         String       @id @default(cuid())
  formId     String
  form       CustodyForm  @relation(fields: [formId], references: [id], onDelete: Cascade)
  documentId String
  document   HeldDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  label      String
  documentNo String?

  @@unique([formId, documentId])
  @@index([documentId])
}

/// Money an employee spent for work and claims back (src/lib/expenses.ts).
model ExpenseClaim {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category      String    @default("OTHER")
  title         String
  amount        Float
  spentAt       DateTime
  receiptUrl    String?
  notes         String?
  /// HR or PORTAL.
  source        String    @default("HR")
  /// PENDING, APPROVED (to be paid), PAID, REJECTED or CANCELLED (by the employee).
  status        String    @default("PENDING")
  decidedByName String?
  decidedAt     DateTime?
  decisionNote  String?
  /// SALARY (added to a salary through payItemId) or CASH / BANK_TRANSFER / CHEQUE.
  payMethod     String?
  payItemId     String?
  paidAt        DateTime?
  paidByName    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

model AuditLog {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  action     String
  message    String
  createdAt  DateTime  @default(now())

  @@index([companyId, createdAt])
}

/// When data last changed, per scope: "c:<companyId>", "p:<companyId>" (what every portal shows),
/// "e:<employeeId>", "t:<taskId>". Written after every database write (src/lib/live.ts); open pages poll it.
model LiveSignal {
  scope String   @id
  at    DateTime @default(now())
}

/// Attempt counters per hashed IP or account (src/lib/rate-limit.ts): sign-in, portal links, device checks.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

/// Server and browser errors grouped by fingerprint (src/lib/errors.ts), shown in Settings › System health.
/// companyId = the signed-in user's company when known; null = public pages, portal, scheduled jobs (platform admins).
model ErrorEvent {
  id          String    @id @default(cuid())
  companyId   String?
  fingerprint String    @unique
  /// SERVER, CLIENT, CRON or BACKUP.
  source      String
  message     String
  /// Next.js error digest, matching the server log entry.
  digest      String?
  /// Page path with ids and tokens masked.
  path        String?
  stack       String?
  count       Int       @default(1)
  firstAt     DateTime  @default(now())
  lastAt      DateTime  @default(now())
  resolvedAt  DateTime?
  notifiedAt  DateTime?

  @@index([companyId, lastAt])
}

/// One run of the daily encrypted backup (neon/backup, written with plain SQL); shown in Settings › System health.
model BackupRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  /// Object key in the private "backups" bucket, e.g. daily/2026-10-14T22-00-00Z.bhdb.
  objectKey  String?
  bytes      Int       @default(0)
  tables     Int       @default(0)
  rows       Int       @default(0)
  /// Files past the 30-day window deleted by this run.
  removed    Int       @default(0)
  error      String?

  @@index([startedAt])
}
