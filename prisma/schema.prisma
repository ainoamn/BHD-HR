generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Company {
  id                   String              @id @default(cuid())
  name                 String
  nameEn               String?
  crNumber             String?
  phone                String?
  email                String?
  address              String?
  logoUrl              String?
  currency             String              @default("ر.ع")
  salaryDays           Int                 @default(30)
  alertUrgentDays      Int                 @default(7)
  alertWarningDays     Int                 @default(30)
  alertEarlyDays       Int                 @default(60)
  payDay               Int                 @default(0)
  leaveWarningDays     Int                 @default(5)
  /// 0 until the built-in job titles, departments and leave types are seeded (src/lib/hr-catalog.ts).
  catalogVersion       Int                 @default(0)
  /// Social Protection Fund (src/lib/oman.ts). Rates are percentages; off until the admin turns it on.
  spfEnabled           Boolean             @default(false)
  spfEmployeeRate      Float               @default(8)
  spfEmployerRate      Float               @default(14.5)
  spfExpatEmployerRate Float               @default(2)
  spfWageCap           Float               @default(3000)
  /// GROSS = basic + fixed allowances + recurring allowances; BASIC = basic only.
  spfBase              String              @default("GROSS")
  /// Payer bank for the WPS salary file.
  bankBic              String?
  bankAccount          String?
  /// Clock-in from the employee portal (src/lib/clock.ts): work site, allowed distance in metres, start time "HH:MM" Muscat.
  clockEnabled         Boolean             @default(false)
  workLat              Float?
  workLng              Float?
  workRadius           Int                 @default(200)
  workStart            String?
  /// Permission lists the admin set per role (src/lib/permissions.ts); a role that is missing uses the built-in preset.
  rolePermissions      Json?
  /// Electronic signature on issued letters (src/lib/letter-seal.ts). Images are copied onto each letter when it is signed.
  signatoryName        String?
  signatoryTitle       String?
  signatureUrl         String?
  stampUrl             String?
  employees            Employee[]
  leaveRequests        LeaveRequest[]
  employeeRequests     EmployeeRequest[]
  clockEntries         ClockEntry[]
  jobTitles            JobTitle[]
  departments          Department[]
  leaveTypes           LeaveType[]
  allowanceTypes       AllowanceType[]
  employeeAllowances   EmployeeAllowance[]
  employers            Employer[]
  memberships          Membership[]
  reminders            Reminder[]
  salaries             Salary[]
  payItems             PayItem[]
  files                StoredFile[]
  auditLogs            AuditLog[]
  tasks                Task[]
  employeeNotes        EmployeeNote[]
  letters              Letter[]
  briefs               DailyBrief[]
  jobOpenings          JobOpening[]
  candidates           Candidate[]
  reviewCycles         ReviewCycle[]
  reviews              PerformanceReview[]
  assets               Asset[]
  expenseClaims        ExpenseClaim[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

/// AI summary of the day's priorities, cached per company, day, language and permission set.
model DailyBrief {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  day       String
  lang      String
  /// Short hash of the viewer's permissions, so nobody sees a brief built from data they cannot open.
  scope     String
  text      String
  createdAt DateTime @default(now())

  @@unique([companyId, day, lang, scope])
}

model User {
  id                 String       @id @default(cuid())
  name               String
  email              String       @unique
  password           String
  mustChangePassword Boolean      @default(true)
  bhdSub             String?      @unique
  /// Sign-in name of an account the system opened for an employee or sponsor (src/lib/accounts.ts).
  username           String?      @unique
  /// That account's first password, encrypted so HR can share it again; cleared once the person sets their own.
  tempPassword       String?
  picture            String?
  lastLoginAt        DateTime?
  memberships        Membership[]
  auditLogs          AuditLog[]
  createdAt          DateTime     @default(now())
}

/// Access to one company (workspace). userId stays empty for an invitation until that email signs in.
model Membership {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("VIEWER")
  /// Permission list used when role = CUSTOM (see src/lib/permissions.ts).
  permissions Json?
  inviteToken String?   @unique
  invitedById String?
  invitedAt   DateTime?
  acceptedAt  DateTime?
  /// The employee or sponsor this account belongs to; EMPLOYEE / TEAM_MANAGER / EMPLOYER see only their own people.
  employeeId  String?   @unique
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employerId  String?   @unique
  employer    Employer? @relation(fields: [employerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([companyId, email])
  @@index([userId])
  @@index([email])
}

model Employer {
  id        String      @id @default(cuid())
  companyId String
  company   Company     @relation(fields: [companyId], references: [id])
  kind      String      @default("COMPANY")
  name      String
  nameEn    String?
  idNumber  String?
  phone     String?
  email     String?
  address   String?
  logoUrl   String?
  notes     String?
  employees Employee[]
  salaries  Salary[]
  account   Membership?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Employee {
  id                 String              @id @default(cuid())
  employeeNumber     String
  fullName           String
  nameEn             String?
  /// ISO country code (src/lib/nationalities.ts); older rows may still hold a nationality name.
  nationality        String?
  gender             String?
  dateOfBirth        DateTime?
  phone              String?
  email              String?
  address            String?
  idNumber           String?
  idExpiry           DateTime?
  idFileUrl          String?
  passportNumber     String?
  passportExpiry     DateTime?
  passportFileUrl    String?
  residenceNumber    String?
  residenceExpiry    DateTime?
  residenceFileUrl   String?
  /// SWIFT/BIC of the employee's bank (src/lib/banks.ts) and the account salaries go to; used by the WPS file.
  bankBic            String?
  bankAccount        String?
  /// Direct manager (an employee of the same company), for the org chart.
  managerId          String?
  manager            Employee?           @relation("ReportsTo", fields: [managerId], references: [id], onDelete: SetNull)
  reports            Employee[]          @relation("ReportsTo")
  /// Key of the employee's personal portal link /portal/<token>; null = no portal.
  portalToken        String?             @unique
  /// Profile photo (/files/<name>, a square JPEG resized in the browser).
  photoUrl           String?
  /// Key of the public badge page /id/<token> behind the employee's QR code; separate from the portal key.
  badgeToken         String?             @unique
  /// The employee's CV per language, {ar?, en?} of src/lib/cv.ts CvContent; edited from the portal or by HR.
  cv                 Json?
  cvUpdatedAt        DateTime?
  /// Names copied from the chosen JobTitle / Department so lists and prints need no join.
  jobTitle           String?
  jobTitleEn         String?
  jobTitleId         String?
  jobTitleRef        JobTitle?           @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)
  department         String?
  departmentEn       String?
  departmentId       String?
  departmentRef      Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  joiningDate        DateTime?
  contractEnd        DateTime?
  status             String              @default("ACTIVE")
  /// Set when the status becomes TERMINATED (turnover figures); empty for employees ended before it was tracked.
  terminatedAt       DateTime?
  annualLeaveDays    Float               @default(30)
  sickLeaveDays      Float               @default(0)
  otherLeaveDays     Float               @default(0)
  /// Days per leave-type key that differ from the type's default; the three columns above are pre-leave-type values.
  leaveDays          Json?
  basicSalary        Float               @default(0)
  housingAllowance   Float               @default(0)
  transportAllowance Float               @default(0)
  otherAllowance     Float               @default(0)
  notes              String?
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  employerId         String?
  employer           Employer?           @relation(fields: [employerId], references: [id])
  documents          EmployeeDocument[]
  attendance         Attendance[]
  leaveCredits       LeaveCredit[]
  salaries           Salary[]
  payItems           PayItem[]
  allowances         EmployeeAllowance[]
  auditLogs          AuditLog[]
  reminders          Reminder[]
  taskAssignments    TaskAssignee[]
  noteEntries        EmployeeNote[]
  letters            Letter[]
  leaveRequests      LeaveRequest[]
  requests           EmployeeRequest[]
  clockEntries       ClockEntry[]
  hiredFrom          Candidate[]
  reviews            PerformanceReview[]
  assets             Asset[]
  expenseClaims      ExpenseClaim[]
  account            Membership?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([companyId, employeeNumber])
}

model JobTitle {
  id            String     @id @default(cuid())
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  nameAr        String
  nameEn        String?
  /// Bilingual job description (src/lib/job-description.ts), drafted by AI and edited by HR; shared by everyone with this title.
  description   Json?
  descriptionAt DateTime?
  descriptionBy String?
  employees     Employee[]
  createdAt     DateTime   @default(now())

  @@unique([companyId, nameAr])
}

model Department {
  id        String     @id @default(cuid())
  companyId String
  company   Company    @relation(fields: [companyId], references: [id])
  nameAr    String
  nameEn    String?
  employees Employee[]
  createdAt DateTime   @default(now())

  @@unique([companyId, nameAr])
}

/// A leave balance. `key` is what Attendance.balanceKey and LeaveCredit.balanceKey store (annual, sick, … or a generated key).
model LeaveType {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  key         String
  nameAr      String
  nameEn      String?
  days        Float    @default(0)
  /// false = only employees whose job title is in jobTitleIds.
  allJobs     Boolean  @default(true)
  jobTitleIds String[] @default([])
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([companyId, key])
}

/// A named allowance (علاوة) with its default calculation and payment frequency.
model AllowanceType {
  id         String              @id @default(cuid())
  companyId  String
  company    Company             @relation(fields: [companyId], references: [id])
  nameAr     String
  nameEn     String?
  /// FIXED amount or PERCENT of `base` (BASIC salary or the whole PACKAGE).
  calc       String              @default("FIXED")
  base       String              @default("BASIC")
  value      Float               @default(0)
  /// MONTHLY, QUARTERLY, SEMI_ANNUAL or ANNUAL; non-monthly ones are paid in payMonth and every interval after it.
  frequency  String              @default("MONTHLY")
  payMonth   Int                 @default(1)
  allowances EmployeeAllowance[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

/// An allowance given to one employee; applied to each unpaid salary month it falls due in (src/lib/pay-items.ts).
model EmployeeAllowance {
  id              String        @id @default(cuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allowanceTypeId String
  allowanceType   AllowanceType @relation(fields: [allowanceTypeId], references: [id])
  calc            String        @default("FIXED")
  base            String        @default("BASIC")
  value           Float         @default(0)
  frequency       String        @default("MONTHLY")
  payMonth        Int           @default(1)
  startYear       Int
  startMonth      Int
  active          Boolean       @default(true)
  lines           SalaryLine[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId])
  @@index([allowanceTypeId])
}

model Reminder {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  title      String
  date       DateTime
  repeat     String    @default("NONE")
  notes      String?
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model EmployeeDocument {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String
  documentNo  String?
  expiryDate  DateTime?
  fileUrl     String?
  notes       String?
  /// Sent by the employee from the portal; stays unreviewed (reviewedAt null) until HR accepts it.
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Leave asked for from the employee portal. Approval records the attendance period (attendanceGroupId).
model LeaveRequest {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Attendance choice: "leave:<balance key>" or UNPAID_LEAVE.
  choice            String
  fromDate          DateTime
  toDate            DateTime
  days              Float
  reason            String?
  /// PENDING, APPROVED, REJECTED or CANCELLED (by the employee).
  status            String    @default("PENDING")
  decidedById       String?
  decidedByName     String?
  decidedAt         DateTime?
  decisionNote      String?
  attendanceGroupId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

/// Something an employee asks for from the portal (src/lib/requests.ts): an official letter, a resignation, a salary advance or anything else.
/// Approving a letter request issues the signed letter (letterId); approving an advance creates the pay item (payItemId).
model EmployeeRequest {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// LETTER, RESIGNATION, ADVANCE or OTHER.
  type          String
  /// LETTER: the letter kind asked for (REQUEST_LETTER_KINDS).
  letterKind    String?
  subject       String?
  details       String?
  /// LETTER: who the letter is addressed to.
  addressee     String?
  /// RESIGNATION: the last working day the employee proposes.
  lastDay       DateTime?
  /// ADVANCE: amount and number of monthly instalments.
  amount        Float?
  installments  Int?
  /// PENDING, APPROVED, REJECTED or CANCELLED (by the employee).
  status        String    @default("PENDING")
  decidedById   String?
  decidedByName String?
  decidedAt     DateTime?
  decisionNote  String?
  letterId      String?   @unique
  letter        Letter?   @relation(fields: [letterId], references: [id], onDelete: SetNull)
  payItemId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

/// One working day's clock-in / clock-out from the portal. `day` is YYYY-MM-DD in Muscat time.
model ClockEntry {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  day         String
  inAt        DateTime
  inLat       Float?
  inLng       Float?
  /// Metres from the work site when clocking in / out; null when the company has no site set.
  inDistance  Float?
  outAt       DateTime?
  outLat      Float?
  outLng      Float?
  outDistance Float?
  /// Minutes after the company's start time; 0 when on time or no start time is set.
  lateMinutes Int       @default(0)
  createdAt   DateTime  @default(now())

  @@unique([employeeId, day])
  @@index([companyId, day])
}

model Attendance {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime
  type          String
  notes         String?
  deductsSalary Boolean  @default(false)
  balanceKey    String?
  groupId       String?
  createdAt     DateTime @default(now())

  @@unique([employeeId, date])
}

model LeaveCredit {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  balanceKey String
  days       Float
  reason     String?
  createdAt  DateTime @default(now())
}

model Salary {
  id                 String       @id @default(cuid())
  companyId          String
  company            Company      @relation(fields: [companyId], references: [id])
  employeeId         String
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year               Int
  month              Int
  employerId         String?
  employer           Employer?    @relation(fields: [employerId], references: [id])
  employerName       String?
  employerNameEn     String?
  employeeName       String
  employeeNameEn     String?
  employeeNumber     String
  jobTitle           String?
  jobTitleEn         String?
  department         String?
  departmentEn       String?
  basicSalary        Float        @default(0)
  housingAllowance   Float        @default(0)
  transportAllowance Float        @default(0)
  otherAllowance     Float        @default(0)
  absenceDays        Float        @default(0)
  absenceDeduction   Float        @default(0)
  otherDeduction     Float        @default(0)
  /// Sums of the pay-item lines below (bonuses, allowances, entitlements / advances, deductions).
  extraEarnings      Float        @default(0)
  extraDeductions    Float        @default(0)
  netSalary          Float        @default(0)
  /// Social Protection Fund: employee share (also a SOCIAL deduction line, inside extraDeductions) and the employer's cost, which is not deducted.
  spfEmployee        Float        @default(0)
  spfEmployer        Float        @default(0)
  notes              String?
  paid               Boolean      @default(false)
  paidAt             DateTime?
  paymentMethod      String?
  paymentReference   String?
  paidByName         String?
  receiptNo          String?
  lines              SalaryLine[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([employeeId, year, month])
  @@unique([companyId, receiptNo])
}

/// Advances, bonuses, allowances, entitlements and deductions that feed monthly salaries (src/lib/pay-items.ts).
model PayItem {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  employeeId    String
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind          String
  title         String
  /// ADVANCE: the whole advance. Other kinds: the amount for each month.
  amount        Float
  issuedAt      DateTime
  startYear     Int
  startMonth    Int
  /// ADVANCE: number of instalments. Other kinds: number of months; empty = every month until stopped.
  months        Int?
  paymentMethod String?
  notes         String?
  stoppedAt     DateTime?
  createdByName String?
  lines         SalaryLine[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([companyId])
  @@index([employeeId])
}

/// A pay item or allowance applied to one monthly salary. Lines of a paid salary never change.
model SalaryLine {
  id          String             @id @default(cuid())
  salaryId    String
  salary      Salary             @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  payItemId   String?
  payItem     PayItem?           @relation(fields: [payItemId], references: [id], onDelete: SetNull)
  allowanceId String?
  allowance   EmployeeAllowance? @relation(fields: [allowanceId], references: [id], onDelete: SetNull)
  kind        String
  title       String
  titleEn     String?
  amount      Float
  deduct      Boolean

  @@index([salaryId])
  @@index([payItemId])
  @@index([allowanceId])
}

/// Uploaded documents and logos. Kept in the database because serverless hosting has no persistent disk.
model StoredFile {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String   @unique
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// A to-do assigned to one or more employees (src/lib/tasks.ts). `position` orders cards inside a status column.
model Task {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  title         String
  description   String?
  /// TODO, IN_PROGRESS, REVIEW or DONE.
  status        String         @default("TODO")
  /// URGENT, HIGH, NORMAL or LOW.
  priority      String         @default("NORMAL")
  startDate     DateTime?
  dueDate       DateTime?
  completedAt   DateTime?
  position      Float          @default(0)
  createdById   String?
  createdByName String?
  assignees     TaskAssignee[]
  items         TaskItem[]
  comments      TaskComment[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([companyId, status])
}

model TaskAssignee {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@index([employeeId])
}

/// Checklist entry inside a task.
model TaskItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String?
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([taskId])
}

/// Dated note in an employee's file, written by a system user.
model EmployeeNote {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// GENERAL, PERFORMANCE, CONDUCT, TRAINING or PRAISE.
  kind       String   @default("GENERAL")
  body       String
  pinned     Boolean  @default(false)
  authorId   String?
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
}

/// Warning, notice or letter from management to an employee (src/lib/letters.ts).
/// `token` opens the read-only copy at /letter/<token> that email and WhatsApp copies link to.
/// `verifyToken` is the public check behind the QR code (/verify/<verifyToken>); it can't acknowledge the letter.
/// `fingerprint` is a SHA-256 of the signed content (src/lib/letter-seal.ts), so any change after signing shows on the check page.
model Letter {
  id             String           @id @default(cuid())
  companyId      String
  company        Company          @relation(fields: [companyId], references: [id])
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind           String
  refNo          String
  issuedAt       DateTime
  subject        String
  subjectEn      String?
  body           String
  bodyEn         String?
  signatoryName  String?
  signatoryTitle String?
  createdById    String?
  createdByName  String?
  token          String           @unique
  viewedAt       DateTime?
  acknowledgedAt DateTime?
  cancelledAt    DateTime?
  /// Certificates: who the letter is addressed to (empty = to whom it may concern).
  addressee      String?
  addresseeEn    String?
  verifyToken    String?          @unique
  signedAt       DateTime?
  signedByName   String?
  fingerprint    String?
  signatureUrl   String?
  stampUrl       String?
  request        EmployeeRequest?
  deliveries     LetterDelivery[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([companyId, refNo])
  @@index([employeeId])
}

/// One copy of a letter to send by EMAIL or WHATSAPP. Stays PENDING until that channel is configured (src/lib/delivery.ts).
model LetterDelivery {
  id        String    @id @default(cuid())
  letterId  String
  letter    Letter    @relation(fields: [letterId], references: [id], onDelete: Cascade)
  channel   String
  target    String
  /// PENDING, SENT or FAILED.
  status    String    @default("PENDING")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([letterId])
  @@index([status])
}

/// A vacancy (src/lib/recruitment.ts). `applyToken` opens the public form /apply/<token>; null = not open to the public.
model JobOpening {
  id             String      @id @default(cuid())
  companyId      String
  company        Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title          String
  titleEn        String?
  jobTitleId     String?
  departmentId   String?
  department     String?
  departmentEn   String?
  /// Duties and requirements; also what AI screening compares CVs against.
  description    String?
  location       String?
  /// FULL_TIME, PART_TIME, CONTRACT or INTERNSHIP.
  employmentType String      @default("FULL_TIME")
  openings       Int         @default(1)
  salaryMin      Float?
  salaryMax      Float?
  /// OPEN, ON_HOLD or CLOSED.
  status         String      @default("OPEN")
  applyToken     String?     @unique
  closesAt       DateTime?
  createdByName  String?
  candidates     Candidate[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([companyId, status])
}

model Candidate {
  id              String     @id @default(cuid())
  companyId       String
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobId           String
  job             JobOpening @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fullName        String
  email           String?
  phone           String?
  nationality     String?
  currentTitle    String?
  experienceYears Float?
  expectedSalary  Float?
  /// HR (added by a user) or APPLY_LINK (public form).
  source          String     @default("HR")
  cvUrl           String?
  coverNote       String?
  /// NEW, SCREENING, INTERVIEW, OFFER, HIRED or REJECTED.
  stage           String     @default("NEW")
  /// HR's own 1–5 rating.
  rating          Int?
  /// AI screening against the job description: 0–100 match, summary, strengths and gaps.
  aiScore         Int?
  aiSummary       String?
  aiStrengths     String[]   @default([])
  aiGaps          String[]   @default([])
  aiAt            DateTime?
  interviewAt     DateTime?
  notes           String?
  rejectReason    String?
  /// The employee record created on hiring.
  employeeId      String?
  employee        Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([companyId, stage])
  @@index([jobId])
}

/// A performance review round (src/lib/performance.ts). `criteria` = [{key, ar, en}], each scored 1–5.
model ReviewCycle {
  id            String              @id @default(cuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  periodStart   DateTime
  periodEnd     DateTime
  dueDate       DateTime?
  /// OPEN or CLOSED.
  status        String              @default("OPEN")
  criteria      Json
  createdByName String?
  reviews       PerformanceReview[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([companyId])
}

model PerformanceReview {
  id           String      @id @default(cuid())
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cycleId      String
  cycle        ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// DRAFT or DONE.
  status       String      @default("DRAFT")
  /// {criterionKey: 1–5}
  scores       Json?
  overall      Float?
  strengths    String?
  improvements String?
  goals        String?
  comment      String?
  reviewerName String?
  completedAt  DateTime?
  /// Shown in the employee portal from this time.
  sharedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([cycleId, employeeId])
  @@index([employeeId])
}

/// Company property that can be handed to an employee (custody / عهدة).
model Asset {
  id           String       @id @default(cuid())
  companyId    String
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String
  /// LAPTOP, PHONE, VEHICLE, ACCESS_CARD, TOOL, UNIFORM, FURNITURE or OTHER.
  category     String       @default("OTHER")
  tag          String?
  serialNo     String?
  value        Float?
  purchaseDate DateTime?
  /// AVAILABLE, ASSIGNED, MAINTENANCE or RETIRED.
  status       String       @default("AVAILABLE")
  employeeId   String?
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedAt   DateTime?
  notes        String?
  events       AssetEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

/// History of an asset: CREATE, ASSIGN, RETURN, MAINTENANCE, AVAILABLE or RETIRE.
model AssetEvent {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind         String
  employeeId   String?
  employeeName String?
  note         String?
  byName       String?
  createdAt    DateTime @default(now())

  @@index([assetId])
}

/// Money an employee spent for work and claims back (src/lib/expenses.ts).
model ExpenseClaim {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category      String    @default("OTHER")
  title         String
  amount        Float
  spentAt       DateTime
  receiptUrl    String?
  notes         String?
  /// HR or PORTAL.
  source        String    @default("HR")
  /// PENDING, APPROVED (to be paid), PAID, REJECTED or CANCELLED (by the employee).
  status        String    @default("PENDING")
  decidedByName String?
  decidedAt     DateTime?
  decisionNote  String?
  /// SALARY (added to a salary through payItemId) or CASH / BANK_TRANSFER / CHEQUE.
  payMethod     String?
  payItemId     String?
  paidAt        DateTime?
  paidByName    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId, status])
  @@index([employeeId])
}

model AuditLog {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])
  action     String
  message    String
  createdAt  DateTime  @default(now())

  @@index([companyId, createdAt])
}
